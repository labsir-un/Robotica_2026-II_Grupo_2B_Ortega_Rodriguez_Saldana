    PROC FarmearAura()
        Path_Home;
        ! Posición inicial erguida
        MoveAbsJ Aura_Vertical,v800,fine,Tool_Cuy;
    
        ! Empieza a abrirse mientras gira
        MoveAbsJ Aura_Abre_Der,v400,z10,Tool_Cuy;
        MoveAbsJ Aura_Giro_Der,v400,z10,Tool_Cuy;
    
        ! Giro hacia el lado contrario
        MoveAbsJ Aura_Abre_Izq,v800,z10,Tool_Cuy;
        MoveAbsJ Aura_Giro_Izq,v800,z10,Tool_Cuy;
    
        ! Segunda vuelta más rápida
        MoveAbsJ Aura_Giro_Der,v400,z10,Tool_Cuy;
        MoveAbsJ Aura_Giro_Izq,v400,z10,Tool_Cuy;
    
        ! Cierre elegante
        MoveAbsJ Aura_Abre_Der,v800,z20,Tool_Cuy;
        MoveAbsJ Aura_Vertical,v800,fine,Tool_Cuy;
        
        ! Saludo rápido con muñeca
        MoveAbsJ Aura_Saludo_1,v1000,z10,Tool_Cuy;
        MoveAbsJ Aura_Saludo_2,v1000,z10,Tool_Cuy;
        MoveAbsJ Aura_Saludo_3,v1000,z10,Tool_Cuy;
        MoveAbsJ Aura_Saludo_4,v1000,z10,Tool_Cuy;
        MoveAbsJ Aura_Saludo_5,v1000,z10,Tool_Cuy;
        MoveAbsJ Aura_Saludo_6,v1000,z10,Tool_Cuy;
        MoveAbsJ Aura_Saludo_Fin,v1000,fine,Tool_Cuy;
        
        Path_Home;
    ENDPROC
    PROC Mantenimiento()
        Path_Home;   
        MoveAbsJ Mant_Aprox,v400,fine,Tool_Cuy;
    
    ENDPROC
    
