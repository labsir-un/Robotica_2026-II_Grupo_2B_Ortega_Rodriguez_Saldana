    PROC main()
        SET FWD_Conveyor;
        
        WHILE TRUE DO

            IF DI_01 = 1 THEN
                SET BWD_Conveyor;
                WaitTime 3;
                RESET BWD_Conveyor;
                WaitTime 0.5;
                SET DO_01;
                EscribirNombres;
                RESET DO_01;
                SET BWD_Conveyor;
                WaitTime 2;
                RESET BWD_Conveyor;
                
            ELSEIF DI_01 = 1 AND DI_02 = 1 THEN
                                
                RESET FWD_Conveyor;
                SET BWD_Conveyor;
                WaitTime 5.5;
                RESET BWD_Conveyor;

            ELSEIF DI_03 = 1 THEN
                FarmearAura;
                WaitDI DI_03,0;

            ELSEIF DI_02 = 1 THEN
                Mantenimiento;
                WaitDI DI_02,0;

            ELSE
                WaitTime 0.05;
            ENDIF

        ENDWHILE
        
    ENDPROC
    
